<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F8FC">

    <LinearLayout
        android:id="@+id/homeView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="96dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/logo_plate"
                        android:contentDescription="@string/app_name"
                        android:padding="6dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/logo" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="P.S Pakpi"
                            android:textColor="#0E1B3D"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Enterprises"
                            android:textColor="#5C6984"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnOpenAdmin"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/chip_outline"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:minWidth="72dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="Admin"
                        android:textColor="#1E3A8A"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/hero_panel"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/chip_soft"
                        android:paddingStart="12dp"
                        android:paddingTop="7dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="7dp"
                        android:text="Works, supply and services"
                        android:textColor="#1E3A8A"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:lineSpacingExtra="2dp"
                        android:text="Manage every business request from one mobile desk."
                        android:textColor="#0A1433"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Construction works, supply works, bakery orders, consultancy and many more services are ready for quote capture and follow-up."
                        android:textColor="#516078"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnExploreServices"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:background="@drawable/primary_button"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="Explore services"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnQuickQuote"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:background="@drawable/white_button"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="Quick quote"
                            android:textColor="#1E3A8A"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="86dp"
                        android:layout_weight="1"
                        android:background="@drawable/stat_panel"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4+"
                            android:textColor="#0E1B3D"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Services"
                            android:textColor="#65728A"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="86dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/stat_panel"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="7"
                            android:textColor="#0E1B3D"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Industries"
                            android:textColor="#65728A"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="86dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/stat_panel"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Offline"
                            android:textColor="#0E1B3D"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ready"
                            android:textColor="#65728A"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:text="Service desk"
                    android:textColor="#0E1B3D"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/cardConstruction"
                    style="@style/ServiceCard"
                    android:layout_marginTop="12dp">

                    <TextView
                        style="@style/ServiceIcon"
                        android:background="@drawable/icon_blue"
                        android:text="CW" />

                    <LinearLayout style="@style/ServiceCopy">
                        <TextView
                            style="@style/ServiceTitle"
                            android:text="Construction Works" />
                        <TextView
                            style="@style/ServiceText"
                            android:text="Project planning, execution support and site service inquiries." />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardSupply"
                    style="@style/ServiceCard">

                    <TextView
                        style="@style/ServiceIcon"
                        android:background="@drawable/icon_green"
                        android:text="SW" />

                    <LinearLayout style="@style/ServiceCopy">
                        <TextView
                            style="@style/ServiceTitle"
                            android:text="Supply Works" />
                        <TextView
                            style="@style/ServiceText"
                            android:text="Material sourcing, retail, manufacturing and delivery requests." />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardBakery"
                    style="@style/ServiceCard">

                    <TextView
                        style="@style/ServiceIcon"
                        android:background="@drawable/icon_warm"
                        android:text="BK" />

                    <LinearLayout style="@style/ServiceCopy">
                        <TextView
                            style="@style/ServiceTitle"
                            android:text="Bakery" />
                        <TextView
                            style="@style/ServiceText"
                            android:text="Fresh products, custom orders and event bakery quotes." />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardConsultancy"
                    style="@style/ServiceCard">

                    <TextView
                        style="@style/ServiceIcon"
                        android:background="@drawable/icon_violet"
                        android:text="CN" />

                    <LinearLayout style="@style/ServiceCopy">
                        <TextView
                            style="@style/ServiceTitle"
                            android:text="Consultancy" />
                        <TextView
                            style="@style/ServiceText"
                            android:text="Business advisory, documentation and professional follow-up." />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardManyMore"
                    style="@style/ServiceCard">

                    <TextView
                        style="@style/ServiceIcon"
                        android:background="@drawable/icon_slate"
                        android:text="MM" />

                    <LinearLayout style="@style/ServiceCopy">
                        <TextView
                            style="@style/ServiceTitle"
                            android:text="Many More" />
                        <TextView
                            style="@style/ServiceText"
                            android:text="Education, healthcare, public services and other custom work." />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="@drawable/bottom_bar"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <TextView
                android:id="@+id/navHome"
                style="@style/BottomNavItem"
                android:text="Home" />

            <TextView
                android:id="@+id/navServices"
                style="@style/BottomNavItem"
                android:text="Services" />

            <TextView
                android:id="@+id/navAdmin"
                style="@style/BottomNavItem"
                android:text="Admin" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/webContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F6F8FC"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="#FFFFFF"
            android:elevation="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/btnBackHome"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/chip_outline"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="X"
                android:textColor="#1E3A8A"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/webTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="Client portal"
                android:textColor="#0E1B3D"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnClient"
                style="@style/WebHeaderButton"
                android:text="Client" />

            <TextView
                android:id="@+id/btnAdmin"
                style="@style/WebHeaderButton"
                android:layout_marginStart="8dp"
                android:text="Admin" />

            <TextView
                android:id="@+id/btnLogout"
                style="@style/WebHeaderButton"
                android:layout_marginStart="8dp"
                android:text="Logout" />
        </LinearLayout>

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</FrameLayout>
